APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-unique-32-character-minimum-random-secret
DATABASE_URL=./data/interview.db
DEMO_MODE=true
# P1 and P3: server-only OpenAI-compatible Chat Completions JSON provider
# OPENAI_API_KEY=
# AI_MODEL=gpt-4.1-mini
# LLM_BASE_URL=https://api.openai.com/v1
# P2: Azure Speech; never expose the subscription key in client code
# AZURE_SPEECH_REGION=eastus
# AZURE_SPEECH_KEY=

# Opt-in for trusted self-hosted instances only; never expose shared host CLI credentials to untrusted users.
# Install/login to codex and/or agy under the server OS account before enabling.
ENABLE_LOCAL_AI_CLI=false
