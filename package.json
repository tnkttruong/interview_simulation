{
  "name": "interview-simulation",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @interview/web dev",
    "build": "pnpm --filter @interview/web build",
    "start": "pnpm --filter @interview/web start",
    "lint": "pnpm --filter @interview/web lint",
    "typecheck": "pnpm --filter @interview/web typecheck",
    "test": "pnpm --filter @interview/core test && pnpm --filter @interview/web test",
    "test:e2e": "pnpm --filter @interview/web test:e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @interview/web db:generate",
    "db:migrate": "pnpm --filter @interview/web db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
